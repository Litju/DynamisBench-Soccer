{
  "$defs": {
    "Acquisition": {
      "additionalProperties": false,
      "properties": {
        "alignments": {
          "items": {
            "$ref": "#/$defs/Alignment"
          },
          "title": "Alignments",
          "type": "array"
        },
        "clocks": {
          "items": {
            "$ref": "#/$defs/Clock"
          },
          "minItems": 1,
          "title": "Clocks",
          "type": "array"
        },
        "frames": {
          "items": {
            "$ref": "#/$defs/Frame"
          },
          "title": "Frames",
          "type": "array"
        },
        "reference_clock": {
          "title": "Reference Clock",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/AcquisitionSource"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "clocks",
        "reference_clock",
        "sources"
      ],
      "title": "Acquisition",
      "type": "object"
    },
    "AcquisitionSource": {
      "additionalProperties": false,
      "properties": {
        "calibration": {
          "items": {
            "$ref": "#/$defs/Calibration"
          },
          "title": "Calibration",
          "type": "array"
        },
        "calibration_unknown_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration Unknown Reason"
        },
        "channels": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Channels",
          "type": "array"
        },
        "clock": {
          "title": "Clock",
          "type": "string"
        },
        "device": {
          "$ref": "#/$defs/Device"
        },
        "geometry": {
          "$ref": "#/$defs/Geometry"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "raw_format": {
          "minLength": 1,
          "title": "Raw Format",
          "type": "string"
        },
        "source_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        }
      },
      "required": [
        "id",
        "device",
        "clock",
        "channels",
        "geometry",
        "raw_format"
      ],
      "title": "AcquisitionSource",
      "type": "object"
    },
    "Alignment": {
      "additionalProperties": false,
      "properties": {
        "clock": {
          "title": "Clock",
          "type": "string"
        },
        "drift_ppm": {
          "default": 0,
          "title": "Drift Ppm",
          "type": "number"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "offset_s": {
          "title": "Offset S",
          "type": "number"
        },
        "origin_s": {
          "default": 0,
          "title": "Origin S",
          "type": "number"
        },
        "reference_clock": {
          "title": "Reference Clock",
          "type": "string"
        },
        "sync_events": {
          "description": "paired source/reference timestamps; ref=t+offset+(t-origin)*drift*1e-6",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 1,
          "title": "Sync Events",
          "type": "array"
        },
        "uncertainty_s": {
          "minimum": 0,
          "title": "Uncertainty S",
          "type": "number"
        }
      },
      "required": [
        "clock",
        "reference_clock",
        "method",
        "offset_s",
        "uncertainty_s",
        "sync_events"
      ],
      "title": "Alignment",
      "type": "object"
    },
    "BundleKind": {
      "enum": [
        "timeseries",
        "events",
        "summary"
      ],
      "title": "BundleKind",
      "type": "string"
    },
    "Calibration": {
      "additionalProperties": false,
      "properties": {
        "bias": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bias"
